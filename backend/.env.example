# Server Configuration
PORT=4001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DEBUG=true

# Database Configuration (Replace with your MongoDB connection string)
MONGO_URI=mongodb://localhost:27017/aurora
# Example MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aurora?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Master Admin Credentials
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_EMAIL=masteradmin@aurora.com
MASTER_ADMIN_PASSWORD=Admin@1234
